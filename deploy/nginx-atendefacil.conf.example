server {
    listen 80;
    server_name 172.29.3.35;
    client_max_body_size 25M;

    location = /atendefacil {
        return 301 /atendefacil/;
    }

    location /atendefacil/ {
        # Troque 3100 pela APP_PORT mostrada pelo instalador.
        # Sem barra após a porta: o prefixo /atendefacil deve ser preservado.
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix /atendefacil;
        proxy_read_timeout 300s;
    }
}
